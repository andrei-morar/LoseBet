<Window x:Class="LoseBet.Desktop.SlotsLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Casino Lobby - Slots" Height="600" Width="1000" Background="#121212" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1F1F1F" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <Button Content="⬅ Înapoi" Width="80" Height="35" Click="BtnBack_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="Gold" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="🔄" Width="40" Height="35" Click="BtnRefresh_Click" Background="#444" Foreground="White"/>
                </StackPanel>
                <TextBlock Text="PĂCĂNELE" Foreground="White" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl x:Name="ItemsGames">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="180" Height="240" Margin="10" Click="BtnPlayGame_Click" Tag="{Binding}" Background="#252525" BorderThickness="0">
                            <StackPanel>
                                <Border CornerRadius="10" Margin="5" Height="170" Background="#333">
                                    <Image Source="{Binding ThumbnailUrl, StringFormat='/Resources/Slots/{0}'}" 
                                        Stretch="UniformToFill" 
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                                <TextBlock Text="JOACĂ ACUM" Foreground="LimeGreen" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>