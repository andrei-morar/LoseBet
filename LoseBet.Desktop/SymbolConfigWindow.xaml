<Window x:Class="LoseBet.Desktop.SymbolConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurare Simbol" Height="380" Width="400" WindowStartupLocation="CenterOwner" Background="#111">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Configurare Simbol Nou" Foreground="Gold" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Imagine Simbol:" Foreground="White"/>
            <DockPanel Margin="0,0,0,15">
                <Button Content="📁 Browse" Width="80" DockPanel.Dock="Right" Click="BtnBrowse_Click" Margin="5,0,0,0"/>
                <TextBox x:Name="TxtImageFile" Height="25" IsReadOnly="True" Background="#333" Foreground="White" Text="Niciun fișier selectat..."/>
            </DockPanel>

            <TextBlock Text="Setări Multiplicatori (Ex: 0.5, 2.0, 10.0)" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
            <UniformGrid Columns="2" Margin="0,0,0,15">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Plată la 3x:" Foreground="White"/>
                    <TextBox x:Name="TxtMult3" Text="0" Height="25"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Plată la 4x:" Foreground="White"/>
                    <TextBox x:Name="TxtMult4" Text="0" Height="25"/>
                </StackPanel>
            </UniformGrid>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Plată la 5x:" Foreground="White"/>
                <TextBox x:Name="TxtMult5" Text="0" Height="25"/>
            </StackPanel>

            <CheckBox x:Name="ChkIsWild" Content="Acesta este simbolul WILD (Joker)" Foreground="Lime" FontWeight="Bold" Margin="0,0,0,20"/>

            <DockPanel>
                <Button Content="Anulează" Width="100" Height="35" Click="BtnCancel_Click" Background="DarkRed" Foreground="White"/>
                <Button Content="Salvează Simbolul" Height="35" Margin="10,0,0,0" Click="BtnSave_Click" Background="DarkGreen" Foreground="White" FontWeight="Bold"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>