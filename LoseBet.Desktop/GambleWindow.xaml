<Window x:Class="LoseBet.Desktop.GambleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dublaj - Roșie / Neagră" Height="529" Width="416" WindowStartupLocation="CenterOwner" Background="#111" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="DUBLAJ" Foreground="Gold" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="Suma riscată: " Foreground="White" FontSize="16"/>
                <TextBlock x:Name="TxtGambleAmount" Text="0.00 RON" Foreground="Yellow" FontSize="18" FontWeight="Bold"/>
            </StackPanel>

            <Border x:Name="CardBorder" Width="120" Height="170" Background="White" CornerRadius="10" BorderBrush="Gold" BorderThickness="2" Margin="0,0,0,20">
                <TextBlock x:Name="TxtCardValue" Text="?" FontSize="80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#333"/>
            </Border>

            <TextBlock x:Name="TxtResult" Text="Alege o culoare!" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <UniformGrid Columns="2" Width="300">
                <Button x:Name="BtnRed" Content="♥ ROȘIE (x2)" Background="DarkRed" Foreground="White" FontSize="16" FontWeight="Bold" Height="50" Margin="0,0,10,0" Click="BtnRed_Click"/>
                <Button x:Name="BtnBlack" Content="♠ NEAGRĂ (x2)" Background="#1A1A1A" Foreground="White" FontSize="16" FontWeight="Bold" Height="50" Margin="10,0,0,0" Click="BtnBlack_Click"/>
            </UniformGrid>

            <Button x:Name="BtnCollect" Content="💰 COLECTEAZĂ" Background="DarkGreen" Foreground="White" FontSize="16" FontWeight="Bold" Height="40" Width="200" Margin="0,20,0,0" Click="BtnCollect_Click"/>
        </StackPanel>
    </Grid>
</Window>