<Window x:Class="LoseBet.Desktop.GambleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dublaj" Height="400" Width="600" WindowStartupLocation="CenterOwner" Background="#1a1a1a">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="SUMĂ DE DUBLAT" Foreground="Gray" HorizontalAlignment="Center" FontSize="14"/>
            <TextBlock x:Name="TxtGambleAmount" Text="100.00" Foreground="Gold" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Border x:Name="CardBorder" Width="100" Height="140" Background="White" CornerRadius="10" Margin="0,0,0,30">
                <TextBlock x:Name="TxtCardSymbol" Text="?" FontSize="60" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Black"/>
            </Border>

            <UniformGrid Columns="2" Width="400">
                <Button Content="ROȘU" Background="Red" Foreground="White" Height="60" FontSize="20" FontWeight="Bold" Margin="10" Click="BtnRed_Click"/>
                <Button Content="NEGRU" Background="Black" Foreground="White" Height="60" FontSize="20" FontWeight="Bold" Margin="10" Click="BtnBlack_Click" BorderBrush="Gray"/>
            </UniformGrid>

            <Button Content="ÎNCASEAZĂ" Background="DarkGreen" Foreground="White" Height="40" Width="150" Margin="0,20,0,0" Click="BtnCollect_Click"/>
        </StackPanel>
    </Grid>
</Window>