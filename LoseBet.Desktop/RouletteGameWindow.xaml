<Window x:Class="LoseBet.Desktop.RouletteGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Pro Roulette" Height="700" Width="1150" WindowStartupLocation="CenterScreen" Background="#063D1E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button Content="⬅ Lobby" Click="BtnBack_Click" Width="80" Height="30" HorizontalAlignment="Left" Background="#1a1a1a" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="Gold" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="350" Height="350">
                <Canvas x:Name="WheelCanvas" Width="350" Height="350" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="WheelRotation" Angle="0"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <Ellipse x:Name="RouletteBall" Width="14" Height="14" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,25,0,0">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="BallRotation" Angle="0" CenterX="7" CenterY="150"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <TextBlock x:Name="TxtWheelResult" Text="?" Foreground="White" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Button Content="0" Click="BtnBet_Click" Tag="0" Background="#008000" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Column="0" Grid.RowSpan="3" BorderBrush="White" Cursor="Hand"/>

                <Button Content="3" Click="BtnBet_Click" Tag="3" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="1" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="6" Click="BtnBet_Click" Tag="6" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="2" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="9" Click="BtnBet_Click" Tag="9" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="3" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="12" Click="BtnBet_Click" Tag="12" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="4" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="15" Click="BtnBet_Click" Tag="15" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="5" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="18" Click="BtnBet_Click" Tag="18" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="6" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="21" Click="BtnBet_Click" Tag="21" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="7" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="24" Click="BtnBet_Click" Tag="24" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="8" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="27" Click="BtnBet_Click" Tag="27" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="9" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="30" Click="BtnBet_Click" Tag="30" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="10" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="33" Click="BtnBet_Click" Tag="33" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="11" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="36" Click="BtnBet_Click" Tag="36" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="12" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>
                <Button Content="2to1" Click="BtnBet_Click" Tag="Col3" Background="Transparent" Foreground="White" FontWeight="Bold" Grid.Column="13" Grid.Row="0" BorderBrush="White" Cursor="Hand"/>

                <Button Content="2" Click="BtnBet_Click" Tag="2" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="1" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="5" Click="BtnBet_Click" Tag="5" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="2" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="8" Click="BtnBet_Click" Tag="8" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="3" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="11" Click="BtnBet_Click" Tag="11" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="4" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="14" Click="BtnBet_Click" Tag="14" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="5" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="17" Click="BtnBet_Click" Tag="17" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="6" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="20" Click="BtnBet_Click" Tag="20" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="7" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="23" Click="BtnBet_Click" Tag="23" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="8" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="26" Click="BtnBet_Click" Tag="26" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="9" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="29" Click="BtnBet_Click" Tag="29" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="10" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="32" Click="BtnBet_Click" Tag="32" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="11" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="35" Click="BtnBet_Click" Tag="35" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="12" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>
                <Button Content="2to1" Click="BtnBet_Click" Tag="Col2" Background="Transparent" Foreground="White" FontWeight="Bold" Grid.Column="13" Grid.Row="1" BorderBrush="White" Cursor="Hand"/>

                <Button Content="1" Click="BtnBet_Click" Tag="1" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="1" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="4" Click="BtnBet_Click" Tag="4" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="2" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="7" Click="BtnBet_Click" Tag="7" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="3" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="10" Click="BtnBet_Click" Tag="10" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="4" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="13" Click="BtnBet_Click" Tag="13" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="5" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="16" Click="BtnBet_Click" Tag="16" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="6" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="19" Click="BtnBet_Click" Tag="19" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="7" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="22" Click="BtnBet_Click" Tag="22" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="8" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="25" Click="BtnBet_Click" Tag="25" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="9" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="28" Click="BtnBet_Click" Tag="28" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="10" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="31" Click="BtnBet_Click" Tag="31" Background="#111" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="11" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="34" Click="BtnBet_Click" Tag="34" Background="#cc0000" Foreground="White" FontSize="18" FontWeight="Bold" Grid.Column="12" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="2to1" Click="BtnBet_Click" Tag="Col1" Background="Transparent" Foreground="White" FontWeight="Bold" Grid.Column="13" Grid.Row="2" BorderBrush="White" Cursor="Hand"/>

                <Button Content="1st 12" Click="BtnBet_Click" Tag="1st12" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="16" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="White" Cursor="Hand"/>
                <Button Content="2nd 12" Click="BtnBet_Click" Tag="2nd12" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="16" Grid.Column="5" Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="White" Cursor="Hand"/>
                <Button Content="3rd 12" Click="BtnBet_Click" Tag="3rd12" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="16" Grid.Column="9" Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="White" Cursor="Hand"/>

                <Button Content="1 to 18" Click="BtnBet_Click" Tag="1to18" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="14" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="EVEN" Click="BtnBet_Click" Tag="Even" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="14" Grid.Column="3" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="RED" Click="BtnBet_Click" Tag="Red" Background="#cc0000" Foreground="White" FontWeight="Bold" FontSize="16" Grid.Column="5" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="BLACK" Click="BtnBet_Click" Tag="Black" Background="#111" Foreground="White" FontWeight="Bold" FontSize="16" Grid.Column="7" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="ODD" Click="BtnBet_Click" Tag="Odd" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="14" Grid.Column="9" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="White" Cursor="Hand"/>
                <Button Content="19 to 36" Click="BtnBet_Click" Tag="19to36" Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="14" Grid.Column="11" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="White" Cursor="Hand"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="MIZĂ (RON):" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox x:Name="TxtBetAmount" Text="10" Width="100" Height="40" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center"/>
            <Button Content="SPIN" Click="BtnSpin_Click" Width="200" Height="50" Margin="20,0,0,0" Background="Gold" FontSize="20" FontWeight="Bold" Cursor="Hand"/>
            <TextBlock x:Name="TxtStatus" Text="Apasă pe tabel pentru a paria!" Foreground="LightGreen" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="30,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>