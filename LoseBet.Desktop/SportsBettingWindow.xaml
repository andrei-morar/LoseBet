<Window x:Class="LoseBet.Desktop.SportsBettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pariuri Sportive" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1F1F1F" Padding="15,0">
            <DockPanel VerticalAlignment="Center">
                <Button Content="⬅ Înapoi" Width="80" Height="30" Click="BtnBack_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Sold: " Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="Gold" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>
                <TextBlock Text="🏆 LoseBet Sports" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="#1A1A1A">
            <TabItem Header="⚽ Ofertă Meciuri">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsMatches">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252525" Margin="5" Padding="10" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HomeTeam}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="vs" Foreground="Gray" FontSize="12" Margin="0,2"/>
                                                <TextBlock Text="{Binding AwayTeam}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding Odds1}" Tag="1" DataContext="{Binding}" Click="BtnOdd_Click" Width="50" Height="35" Margin="5" Background="#333" Foreground="White" FontWeight="Bold" ToolTip="Victorie Gazde"/>
                                                <Button Content="{Binding OddsX}" Tag="X" DataContext="{Binding}" Click="BtnOdd_Click" Width="50" Height="35" Margin="5" Background="#333" Foreground="White" FontWeight="Bold" ToolTip="Egal"/>
                                                <Button Content="{Binding Odds2}" Tag="2" DataContext="{Binding}" Click="BtnOdd_Click" Width="50" Height="35" Margin="5" Background="#333" Foreground="White" FontWeight="Bold" ToolTip="Victorie Oaspeți"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="🎫 BILETUL TĂU" Foreground="Gold" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                            <ListBox x:Name="LstBetSlip" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="5" Width="300">
                                            <DockPanel>
                                                <Button Content="✕" DockPanel.Dock="Right" Click="BtnRemoveSelection_Click" Tag="{Binding MatchId}" Background="Transparent" Foreground="Red" BorderThickness="0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MatchName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                    <TextBlock Foreground="LightGray" FontSize="12">
                                                        <Run Text="Pronostic: "/>
                                                        <Run Text="{Binding Pick}" FontWeight="Bold" Foreground="Gold"/>
                                                        <Run Text=" | Cotă: "/>
                                                        <Run Text="{Binding Odds}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2">
                                <DockPanel Margin="0,5">
                                    <TextBlock Text="Cota Totală:" Foreground="White" FontSize="16"/>
                                    <TextBlock x:Name="TxtTotalOdds" Text="1.00" Foreground="Lime" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <DockPanel Margin="0,5,0,15">
                                    <TextBlock Text="Miză (RON):" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtStake" Text="10" Width="100" Height="25" HorizontalAlignment="Right" TextAlignment="Right" TextChanged="TxtStake_TextChanged"/>
                                </DockPanel>

                                <DockPanel Margin="0,5,0,15">
                                    <TextBlock Text="Câștig Potențial:" Foreground="White" FontSize="16"/>
                                    <TextBlock x:Name="TxtPotentialWin" Text="10.00" Foreground="Gold" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Button x:Name="BtnPlaceBet" Content="🚀 PLASEAZĂ BILETUL" Height="45" Background="DarkGreen" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnPlaceBet_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="📜 Biletele Mele">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TicketsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,15" Padding="15" CornerRadius="8" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#252525"/>
                                            <Setter Property="BorderBrush" Value="#444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Won">
                                                    <Setter Property="Background" Value="#153015"/>
                                                    <Setter Property="BorderBrush" Value="#00AA00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Lost">
                                                    <Setter Property="Background" Value="#301515"/>
                                                    <Setter Property="BorderBrush" Value="#AA0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="BorderBrush" Value="Goldenrod"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock Text="🎫 Bilet ID: " Foreground="White" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding Id}" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,15,0"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="Gray" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Status}" FontWeight="Black" FontSize="16" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Goldenrod"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Won">
                                                                <Setter Property="Foreground" Value="Lime"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Lost">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Selections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#111" Padding="8" Margin="0,2" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Background="#333" Padding="6,2" CornerRadius="3" Margin="0,0,15,0">
                                                                <TextBlock Text="{Binding Pick, StringFormat='Pronostic: {0}'}" Foreground="Gold" FontWeight="Bold"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Match.HomeTeam}" Foreground="White" FontWeight="Bold" FontSize="14"/>

                                                                <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                                                                    <TextBlock Text=" vs " Foreground="Gray">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Match.IsFinished}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <StackPanel Orientation="Horizontal">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Match.IsFinished}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <TextBlock Text="  " />
                                                                        <TextBlock Text="{Binding Match.HomeScore}" Foreground="Cyan" FontWeight="Bold" FontSize="14"/>
                                                                        <TextBlock Text=" - " Foreground="Cyan" FontSize="14"/>
                                                                        <TextBlock Text="{Binding Match.AwayScore}" Foreground="Cyan" FontWeight="Bold" FontSize="14"/>
                                                                        <TextBlock Text="  " />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding Match.AwayTeam}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2" Text="{Binding Odds, StringFormat='Cotă: {0:F2}'}" Foreground="LightGray" Margin="15,0" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="3" Text="{Binding Status}" FontWeight="Bold" Width="60" TextAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="Goldenrod"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Won">
                                                                                <Setter Property="Foreground" Value="Lime"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Lost">
                                                                                <Setter Property="Foreground" Value="Red"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Rectangle Height="1" Fill="#555" Margin="0,10"/>
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Miză: " Foreground="LightGray" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Stake, StringFormat='{}{0:F2} RON'}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cotă Totală: " Foreground="LightGray" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalOdds, StringFormat='{}{0:F2}'}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Câștig Potențial: " Foreground="LightGray" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PotentialWin, StringFormat='{}{0:F2} RON'}" Foreground="Gold" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>