<Window x:Class="LoseBet.Desktop.RouletteLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Lobby Ruletă" Height="500" Width="700" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Button Content="⬅ Înapoi la Dashboard" Click="BtnBack_Click" Width="150" Height="30" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" FontSize="18" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="ALEGE O RULETĂ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <WrapPanel HorizontalAlignment="Center">
                <Button Content="🇪🇺 European Roulette" Click="BtnPlayEuro_Click" Width="180" Height="130" Margin="15" Background="LightGray" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="🇺🇸 American Roulette" Click="BtnPlayAmer_Click" Width="180" Height="130" Margin="15" Background="LightGray" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>