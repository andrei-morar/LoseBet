<Window x:Class="LoseBet.Desktop.RouletteLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet Casino - Lobby Ruletă" Height="600" Width="900" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style TargetType="Button" x:Key="BackButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="RouletteCardStyle">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="300"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Border CornerRadius="15" Background="{TemplateBinding Background}" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CardShadow" Color="Black" BlurRadius="15" Opacity="0.6" ShadowDepth="8"/>
                                </Border.Effect>

                                <Image Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Stretch="UniformToFill"/>
                            </Border>

                            <Border CornerRadius="15" VerticalAlignment="Bottom" Height="100">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#EE000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontWeight="Black" FontSize="18" 
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="15" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Color" To="#FFD700" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                        <ColorAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainAppScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainAppScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AppBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="AppBorder" Opacity="0" CornerRadius="20" Margin="20" BorderBrush="#FFD700" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">

        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.2" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#3A0000" Offset="0.0" />
                <GradientStop Color="#0A0A0A" Offset="1.0" />
            </RadialGradientBrush>
        </Border.Background>

        <Border.RenderTransform>
            <ScaleTransform x:Name="MainAppScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="⬅ Înapoi la Dashboard" Click="BtnBack_Click" Style="{StaticResource BackButtonStyle}"/>

                <TextBlock Grid.Column="1" Text="LOBBY RULETĂ" Foreground="#FFD700" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" x:Name="TxtBalance" Text="Sold: 0.00 RON" FontSize="18" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ALEGE O MASĂ PENTRU A JUCA" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="🇪🇺 European Roulette" Click="BtnPlayEuro_Click" Style="{StaticResource RouletteCardStyle}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2E8B57" Offset="0"/>
                                <GradientStop Color="#004600" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>