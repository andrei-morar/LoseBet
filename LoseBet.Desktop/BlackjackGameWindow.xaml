<Window x:Class="LoseBet.Desktop.BlackjackGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Classic Blackjack" Height="820" Width="1000" WindowStartupLocation="CenterScreen" 
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <Storyboard x:Key="WindowLoadAnim">
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style TargetType="Button" x:Key="VipActionButtonStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#FFD700" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" Opacity="0.5"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                            </Border>
                            <Border x:Name="GlowBorder" CornerRadius="10" BorderBrush="White" BorderThickness="2" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="White" BlurRadius="15" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowLoadAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder" CornerRadius="20" BorderBrush="#FFD700" BorderThickness="2" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="MainScale"/>
        </Border.RenderTransform>

        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#005522" Offset="0"/>
                <GradientStop Color="#001105" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Button Content="⬅ LOBBY" Click="BtnBack_Click" Width="100" Height="35" HorizontalAlignment="Left" Background="#111" Foreground="#FFD700" FontWeight="Bold" BorderBrush="#FFD700" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="LOSEBET CLASSIC BLACKJACK" Foreground="#FFD700" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="#FFD700" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" Panel.ZIndex="0">
                <Border Width="90" Height="130" Background="#002266" BorderBrush="White" BorderThickness="2" CornerRadius="5" Margin="10,10,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="5" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
                <Border Width="90" Height="130" Background="#002266" BorderBrush="White" BorderThickness="2" CornerRadius="5" Margin="5,5,0,0"/>
                <Border Width="90" Height="130" Background="#002266" BorderBrush="White" BorderThickness="2" CornerRadius="5">
                    <Grid>
                        <TextBlock Text="♠ ♥" Foreground="Gold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="♦ ♣" Foreground="Gold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" Opacity="0.5"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#44000000" CornerRadius="15" Margin="50,10,150,10" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtDealerScore" Text="Cărțile Dealerului: ?" Foreground="LightGray" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel x:Name="PanelDealerCards" Orientation="Horizontal" HorizontalAlignment="Center" Height="120"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#CC000000" CornerRadius="10" HorizontalAlignment="Center" Padding="30,10" Margin="0,5">
                <TextBlock x:Name="TxtStatus" Text="Pune miza și apasă DEAL!" Foreground="#FFD700" FontSize="26" FontWeight="Black" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFD700" BlurRadius="15" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <Border Grid.Row="3" Background="#44000000" CornerRadius="15" Margin="50,10,150,10" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel x:Name="PanelPlayerCards" Orientation="Horizontal" HorizontalAlignment="Center" Height="120"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtPlayerScore" Grid.Row="4" Text="Scorul tău: 0" Foreground="White" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,5,0,15">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Grid.Row="5" Background="#081A0B" CornerRadius="15" Padding="15" Margin="0,0,0,10" BorderBrush="#FFD700" BorderThickness="1">
                <Grid>
                    <StackPanel x:Name="PanelBetting" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="MIZĂ (RON):" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>
                        <TextBox x:Name="TxtBetAmount" Text="50" Width="100" Height="45" FontSize="22" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Background="#222" Foreground="#FFD700" BorderBrush="#FFD700">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button x:Name="BtnDeal" Content="🃏 ÎMPARTE (DEAL)" Click="BtnDeal_Click" Width="240" Height="50" Margin="30,0,0,0" Background="#FFD700" Foreground="Black" FontSize="20" FontWeight="Black" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <Button.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PanelActions" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="BtnHit" Content="➕ TRAGE (HIT)" Click="BtnHit_Click" Width="200" Height="50" Margin="15,0" Style="{StaticResource VipActionButtonStyle}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#007F00" Offset="0"/>
                                    <GradientStop Color="#004d00" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button x:Name="BtnStand" Content="🛑 STAI (STAND)" Click="BtnStand_Click" Width="200" Height="50" Margin="15,0" Style="{StaticResource VipActionButtonStyle}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#B20000" Offset="0"/>
                                    <GradientStop Color="#660000" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="WinOverlay" Visibility="Collapsed" Opacity="0" Grid.RowSpan="6" Panel.ZIndex="1000">
                <Grid.Background>
                    <SolidColorBrush Color="Black" Opacity="0.9"/>
                </Grid.Background>

                <Canvas x:Name="FireworksCanvas"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🎺" FontSize="80" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,30,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TrumpetLeftScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform Angle="-30"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Gold" BlurRadius="20" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Grid.Column="1" x:Name="TxtBigWin" Text="AI CÂȘTIGAT!" 
                               Foreground="#FFD700" FontSize="90" FontWeight="Black" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="TxtWinScale" ScaleX="0" ScaleY="0"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="40" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Grid.Column="2" Text="🎺" FontSize="80" Foreground="#FFD700" VerticalAlignment="Center" Margin="30,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TrumpetRightScale" ScaleX="-1" ScaleY="1"/>
                                    <RotateTransform Angle="30"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Gold" BlurRadius="20" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <TextBlock x:Name="TxtWinAmount" Text="+ 100 RON" Foreground="LimeGreen" FontSize="45" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,50">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button Content="💰 COLECTEAZĂ BĂNUȚII" Click="BtnCloseWin_Click" 
                            Width="380" Height="70" 
                            Background="#FFD700" Foreground="Black" FontSize="24" 
                            FontWeight="Black" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect Color="Gold" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>