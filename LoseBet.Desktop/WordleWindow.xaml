<Window x:Class="LoseBet.Desktop.WordleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Wordle Românesc" Height="650" Width="500" Background="#121213" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button Content="⬅ Înapoi" Width="70" Height="30" HorizontalAlignment="Left" Background="#3A3A3C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnBack_Click"/>
            <TextBlock Text="WORDLE" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="#538D4E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="20">
            <UniformGrid x:Name="GridWordle" Columns="5" Rows="6" Width="300" Height="360" HorizontalAlignment="Center">
            </UniformGrid>
        </Viewbox>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Width="350">
            <TextBlock x:Name="TxtStatus" Text="Alege miza și apasă Start!" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel x:Name="PanelStart" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Miza:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtBet" Text="10" Width="60" Height="30" TextAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="START JOC" Click="BtnStart_Click" Width="100" Height="30" Background="#538D4E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <StackPanel x:Name="PanelInput" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBox x:Name="TxtGuess" Width="150" Height="40" FontSize="20" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="5" CharacterCasing="Upper" Margin="0,0,10,0"/>
                <Button Content="GHICEȘTE" Click="BtnSubmit_Click" Width="100" Height="40" Background="#538D4E" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>