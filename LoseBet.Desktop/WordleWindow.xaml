<Window x:Class="LoseBet.Desktop.WordleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Wordle Pro" Height="750" Width="1000" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0A0A0C">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="GreenGlow" Color="#00E676" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>

        <Style TargetType="Button" x:Key="QuickBtnStyle">
            <Setter Property="Background" Value="#1A1B22"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252630"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111115" BorderBrush="#222" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="◄ LOBBY" Width="100" Height="30" Click="BtnBack_Click" Background="#222" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔤" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="W O R D L E   P R O" Foreground="#FFD700" FontSize="24" FontWeight="Black" VerticalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sold curent: " Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="#00E676" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#14151A" Margin="20" CornerRadius="15" BorderBrush="#2A2B35" BorderThickness="2" ClipToBounds="True">
            <Grid>
                <Ellipse Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.05">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFD700" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#111115" BorderBrush="#2A2B35" BorderThickness="1" CornerRadius="10" Padding="20,10" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtStatus" Text="ALEGE MIZA ȘI APASĂ START!" Foreground="#FFD700" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <Viewbox Stretch="Uniform" Height="360">
                        <UniformGrid x:Name="GridWordle" Columns="5" Rows="6" Width="300" Height="360" HorizontalAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#111115" BorderBrush="#222" BorderThickness="0,2,0,0">
            <Grid Margin="30,0">

                <StackPanel x:Name="PanelStart" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">

                    <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="MIZĂ" Foreground="#888" FontSize="12" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <Button Content="½" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="0.5" Click="QuickBet_Click"/>
                            <Button Content="1x" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="1" Click="QuickBet_Click"/>
                            <Button Content="2x" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="2" Click="QuickBet_Click"/>
                            <Button Content="MAX" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="max" Click="QuickBet_Click"/>
                        </StackPanel>

                        <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="-" Width="45" Height="45" Background="#252630" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnLowerBet_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBox x:Name="TxtBet" Text="10.00" Width="100" Height="45" FontSize="20" TextAlignment="Center" FontWeight="Black" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                                <Button Content="+" Width="45" Height="45" Background="#252630" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnHigherBet_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Content="▶ START JOC" Width="280" Height="80" Click="BtnStart_Click" Cursor="Hand" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E7A34" Offset="0"/>
                                <GradientStop Color="#28A745" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect Color="#00E676" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </Button.Effect>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15"/>
                            </Style>
                        </Button.Resources>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontSize>26</Button.FontSize>
                        <Button.FontWeight>Black</Button.FontWeight>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="PanelInput" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="INTRODU UN CUVÂNT DE 5 LITERE:" Foreground="#888" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#FFD700" BorderThickness="2" Padding="5">
                            <TextBox x:Name="TxtGuess" Width="300" Height="60" FontSize="36" FontWeight="Black" TextAlignment="Center" VerticalContentAlignment="Center" CharacterCasing="Upper" MaxLength="5" Background="Transparent" Foreground="White" BorderThickness="0" TextChanged="TxtGuess_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="BtnSubmit" Content="TRIMITE" Width="180" Height="70" Click="BtnSubmit_Click" Cursor="Hand" BorderThickness="0" Margin="0,15,0,0" IsEnabled="False">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D88A00" Offset="0"/>
                                <GradientStop Color="#FFB300" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15"/>
                            </Style>
                        </Button.Resources>
                        <Button.Foreground>Black</Button.Foreground>
                        <Button.FontSize>22</Button.FontSize>
                        <Button.FontWeight>Black</Button.FontWeight>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>