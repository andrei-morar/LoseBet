<Window x:Class="LoseBet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet Casino - Autentificare" Height="650" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="CasinoInputStyle">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="PasswordBox" x:Key="CasinoPasswordStyle">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <TextBox x:Name="PART_TextBox" 
                                 Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat=dd/MM/yyyy}" 
                                 Background="#1A1A1A" Foreground="White" BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="Button" x:Key="CasinoButtonStyle">
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush Color="#FFD700"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="GlowEffect" Color="#FFD700" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="BlurRadius" To="25" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                        <ColorAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFF056" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                        <ColorAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFD700" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="LinkButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.5" />
                    <DoubleAnimation Storyboard.TargetName="MainBorderScale" Storyboard.TargetProperty="ScaleX" From="1.4" To="1" Duration="0:0:1.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainBorderScale" Storyboard.TargetProperty="ScaleY" From="1.4" To="1" Duration="0:0:1.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="BlurRadius" From="100" To="20" Duration="0:0:1.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="Color" From="#FFD700" To="Black" Duration="0:0:2.0" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.2" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#4A0000" Offset="0.0" />
                <GradientStop Color="#0F0F0F" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <Border x:Name="MainBorder" Opacity="0" Background="#99000000" CornerRadius="15" Margin="20" Padding="15" BorderBrush="#FFD700" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="MainBorderScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="MainShadow" Color="#FFD700" BlurRadius="100" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0" Padding="10">
                <Grid ClipToBounds="True">

                    <StackPanel x:Name="PnlRegister" Opacity="0" VerticalAlignment="Center" Margin="10" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="RegisterScale" ScaleX="0" ScaleY="0.8"/>
                        </StackPanel.RenderTransform>

                        <TextBlock Text="CONT NOU" Foreground="#FFD700" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nume:" Foreground="LightGray"/>
                                <TextBox x:Name="TxtRegNume" Style="{StaticResource CasinoInputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prenume:" Foreground="LightGray"/>
                                <TextBox x:Name="TxtRegPrenume" Style="{StaticResource CasinoInputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CNP:" Foreground="LightGray"/>
                        <TextBox x:Name="TxtRegCnp" Style="{StaticResource CasinoInputStyle}"/>

                        <TextBlock Text="Data Nașterii:" Foreground="LightGray"/>
                        <DatePicker x:Name="DpDataNasterii"/>

                        <TextBlock Text="Email:" Foreground="LightGray"/>
                        <TextBox x:Name="TxtRegEmail" Style="{StaticResource CasinoInputStyle}"/>

                        <TextBlock Text="Username:" Foreground="LightGray"/>
                        <TextBox x:Name="TxtRegUsername" Style="{StaticResource CasinoInputStyle}"/>

                        <TextBlock Text="Parolă:" Foreground="LightGray"/>
                        <PasswordBox x:Name="TxtRegPassword" Style="{StaticResource CasinoPasswordStyle}"/>

                        <Button x:Name="BtnRegister" Content="ÎNREGISTREAZĂ-TE" Style="{StaticResource CasinoButtonStyle}" Click="BtnRegister_Click" Margin="0,20,0,10"/>

                        <Button x:Name="BtnShowLogin" Content="Ai deja cont? Loghează-te" Style="{StaticResource LinkButtonStyle}" Margin="0,10,0,20" Click="BtnShowLogin_Click">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RegisterScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RegisterScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="PnlRegister" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" BeginTime="0:0:0.1" />

                                            <DoubleAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="BlurRadius" To="80" Duration="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="Color" To="#FFD700" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="BlurRadius" To="20" Duration="0:0:0.4" BeginTime="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.4" BeginTime="0:0:0.2" />

                                            <DoubleAnimation Storyboard.TargetName="LoginScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LoginScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PnlLogin" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" BeginTime="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PnlLogin" Opacity="1" VerticalAlignment="Center" Margin="10" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="LoginScale" ScaleX="1" ScaleY="1"/>
                        </StackPanel.RenderTransform>

                        <TextBlock Text="LOSEBET CASINO" Foreground="#FFD700" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,30">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Text="Username:" Foreground="LightGray" FontSize="14"/>
                        <TextBox x:Name="TxtLoginUsername" Style="{StaticResource CasinoInputStyle}"/>

                        <TextBlock Text="Parolă:" Foreground="LightGray" FontSize="14"/>
                        <PasswordBox x:Name="TxtLoginPassword" Style="{StaticResource CasinoPasswordStyle}"/>

                        <Button x:Name="BtnLogin" Content="INTRĂ ÎN JOC" Style="{StaticResource CasinoButtonStyle}" Click="BtnLogin_Click" Margin="0,20,0,10"/>

                        <Button x:Name="BtnShowRegister" Content="Nu ai cont? Deschide unul nou" Style="{StaticResource LinkButtonStyle}" Margin="0,10,0,0" Click="BtnShowRegister_Click">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LoginScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LoginScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="PnlLogin" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" BeginTime="0:0:0.1" />

                                            <DoubleAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="BlurRadius" To="80" Duration="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="Color" To="#FFD700" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="BlurRadius" To="20" Duration="0:0:0.4" BeginTime="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetName="MainShadow" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.4" BeginTime="0:0:0.2" />

                                            <DoubleAnimation Storyboard.TargetName="RegisterScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RegisterScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PnlRegister" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" BeginTime="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" Margin="0,10,0,0" VerticalAlignment="Bottom"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>