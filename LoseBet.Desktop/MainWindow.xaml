<Window x:Class="LoseBet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet Auth - Vertical Slice" Height="450" Width="350">

    <StackPanel Margin="30" VerticalAlignment="Center">

        <TextBlock Text="Email:" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="TxtEmail" Margin="0,0,0,15" Height="25"/>

        <TextBlock Text="Parolă:" Margin="0,0,0,5" FontWeight="Bold"/>
        <PasswordBox x:Name="TxtPassword" Margin="0,0,0,15" Height="25"/>

        <TextBlock Text="CNP (Doar pentru Register):" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="TxtCnp" Margin="0,0,0,25" Height="25"/>

        <Button Content="Login" Click="BtnLogin_Click" Margin="0,0,0,10" Height="35"/>
        <Button Content="Register" Click="BtnRegister_Click" Margin="0,0,0,20" Height="35"/>

        <TextBlock x:Name="TxtStatus" Text="Aștept acțiune..." TextWrapping="Wrap" 
                   HorizontalAlignment="Center" Foreground="Gray"/>

    </StackPanel>
</Window>