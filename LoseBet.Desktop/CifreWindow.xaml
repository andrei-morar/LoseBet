<Window x:Class="LoseBet.Desktop.CifreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Concurs Matematic" Height="500" Width="700" Background="#2C3E50" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="⬅ Abandon" Click="BtnBack_Click" Width="80" Height="30" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="#2ECC71" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            <TextBlock Text="🔢 CIFRE ȘI CALCULE" Foreground="White" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <StackPanel x:Name="PanelStart" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="Miza (RON):" Foreground="White" HorizontalAlignment="Center"/>
                <TextBox x:Name="TxtBet" Text="10" Width="100" Height="35" FontSize="18" TextAlignment="Center" Margin="0,5,0,10"/>
                <Button Content="▶ START JOC" Click="BtnStart_Click" Width="150" Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" BorderThickness="0"/>
            </StackPanel>

            <StackPanel x:Name="PanelGame" Visibility="Collapsed" HorizontalAlignment="Center">
                <TextBlock Text="NUMĂRUL ȚINTĂ:" Foreground="LightGray" FontSize="16" HorizontalAlignment="Center"/>
                <Border Background="#E67E22" CornerRadius="10" Padding="20" Margin="0,5,0,20" Width="200">
                    <TextBlock x:Name="TxtTarget" Text="456" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Folosește aceste numere:" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <ItemsControl x:Name="ListNumbers" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#ECF0F1" CornerRadius="5" Margin="5" Padding="15,10">
                                <TextBlock Text="{Binding}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Scrie ecuația ta (ex: 100 * 5 - 25):" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center"/>
                <TextBox x:Name="TxtEquation" Width="400" Height="40" FontSize="20" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,5,0,15"/>

                <Button Content="VERIFICĂ" Click="BtnSubmit_Click" Width="200" Height="45" Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="18" Cursor="Hand" BorderThickness="0"/>

                <TextBlock x:Name="TxtTimer" Text="⏳ 60s" Foreground="#E74C3C" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>

        </StackPanel>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
    </Grid>
</Window>