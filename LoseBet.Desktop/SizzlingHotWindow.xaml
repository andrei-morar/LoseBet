<Window x:Class="LoseBet.Desktop.SizzlingHotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Sizzling Hot Deluxe" Height="750" Width="1100" WindowStartupLocation="CenterScreen" 
        Background="#0f0f0f" AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FFD700" BorderThickness="2" CornerRadius="15" Margin="10">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Button Content="⬅ LOBBY" Click="BtnBack_Click" Width="90" Height="30" Background="#333" Foreground="White" HorizontalAlignment="Left">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBlock Text="SIZZLING HOT DELUXE" HorizontalAlignment="Center" FontSize="32" FontWeight="Black" Foreground="Red">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Orange" BlurRadius="10" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <Border Grid.Row="1" BorderBrush="#B0C4DE" BorderThickness="4" CornerRadius="0" Background="#050511">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <UniformGrid x:Name="SlotsGrid" Rows="3" Columns="5" Margin="0">
                </UniformGrid>
            </Border>

            <Border x:Name="PanelDublaj" Grid.Row="2" Visibility="Collapsed" Background="#55000000" CornerRadius="10" Padding="15" Margin="0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="ROȘU" Click="BtnGamble_Click" Tag="Red" Width="120" Height="50" Background="Red" Foreground="White" FontSize="18" FontWeight="Black" Margin="10,0"/>
                    <Button Content="NEGRU" Click="BtnGamble_Click" Tag="Black" Width="120" Height="50" Background="Black" Foreground="White" FontSize="18" FontWeight="Black" Margin="10,0" BorderBrush="White"/>
                    <Button Content="ÎNCASEAZĂ" Click="BtnCollect_Click" Width="150" Height="50" Background="DarkGreen" Foreground="White" FontSize="18" FontWeight="Bold" Margin="40,0,10,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#111" CornerRadius="10" Padding="10" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="CREDIT" Foreground="#aaa" FontSize="12" HorizontalAlignment="Center"/>
                            <Border Background="Black" Padding="10,5" BorderBrush="#333" BorderThickness="1" CornerRadius="3">
                                <TextBlock x:Name="TxtBalance" Text="2000.00" Style="{StaticResource DisplayTextStyle}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="10,0">
                            <TextBlock Text="LAST WIN" Foreground="#aaa" FontSize="12" HorizontalAlignment="Center"/>
                            <Border Background="Black" Padding="20,5" MinWidth="150" BorderBrush="#333" BorderThickness="1" CornerRadius="3">
                                <TextBlock x:Name="TxtStatus" Text="GOOD LUCK!" Foreground="Orange" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="10,0">
                            <TextBlock Text="TOTAL BET" Foreground="#aaa" FontSize="12" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtBet" Text="10" Width="80" Height="40" Background="Black" Foreground="Gold" FontSize="22" FontWeight="Bold" TextAlignment="Center" BorderBrush="#FFD700"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnSpin" Grid.Column="1" Click="BtnSpin_Click" Width="180" Height="65" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="10" BorderThickness="3" BorderBrush="Gold">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#00ff00" Offset="0"/>
                                            <GradientStop Color="#006400" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter.Content>
                                            <TextBlock Text="START" FontSize="28" FontWeight="Black" Foreground="White">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </ContentPresenter.Content>
                                    </ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#00ee00"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>