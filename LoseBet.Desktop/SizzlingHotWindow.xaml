<Window x:Class="LoseBet.Desktop.SizzlingHotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Sizzling Hot Deluxe" Height="650" Width="800" WindowStartupLocation="CenterScreen" Background="#1a1a1a">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Button Content="⬅ Lobby" Click="BtnBack_Click" Width="80" Height="25" Background="#333" Foreground="White" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="Gold" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="Gold" BorderThickness="4" CornerRadius="5" Background="#000" Padding="10">
            <UniformGrid x:Name="SlotsGrid" Rows="3" Columns="5">
            </UniformGrid>
        </Border>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="SIZZLING HOT" Foreground="OrangeRed" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

        <Border x:Name="PanelDublaj" Grid.Row="3" Visibility="Collapsed" Background="#333" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="ROȘIE" Click="BtnGamble_Click" Tag="Red" Width="100" Height="40" Background="Red" Foreground="White" FontWeight="Bold" Margin="5"/>
                <Button Content="NEAGRĂ" Click="BtnGamble_Click" Tag="Black" Width="100" Height="40" Background="Black" Foreground="White" FontWeight="Bold" Margin="5"/>
                <Button Content="ÎNCASEAZĂ" Click="BtnCollect_Click" Width="100" Height="40" Background="Green" Foreground="White" FontWeight="Bold" Margin="5"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Miză:" Foreground="White" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtBet" Text="10" Width="80" Height="40" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnSpin" Content="START (SPIN)" Click="BtnSpin_Click" Width="150" Height="50" Margin="20,0,0,0" Background="Gold" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>