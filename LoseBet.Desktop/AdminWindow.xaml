<Window x:Class="LoseBet.Desktop.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel - LoseBet Pro" Height="750" Width="1200" 
        WindowStartupLocation="CenterScreen" Background="#0A0A0C">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="RedGlow" Color="#E53935" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1B22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1B22"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#14151A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1A1B22"/>
            <Setter Property="AlternatingRowBackground" Value="#14151A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2A2B35"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111115"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2979FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl Margin="10" Background="#111115" BorderBrush="#2A2B35" BorderThickness="1">

            <TabItem Header=" 👥 JUCĂTORI " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersGrid" IsReadOnly="True" AutoGenerateColumns="True" SelectionMode="Single" Margin="0,0,0,15" Grid.Row="0"/>

                    <Border Grid.Row="1" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🔄 REFRESH LISTĂ" Width="140" Height="40" Click="BtnRefresh_Click" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,20,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🚫 BAN / UNBAN" Width="120" Height="40" Click="BtnToggleBan_Click" Background="#E53935" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,40,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <TextBlock Text="Setare Balanță:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAmount" Width="80" Height="40" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="💰 SALVEAZĂ SOLD" Width="140" Height="40" Click="BtnUpdateMoney_Click" Background="#00E676" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,40,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <TextBlock Text="Setare Rol:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbRoles" Width="100" Height="40" Margin="0,0,10,0" SelectedIndex="0" FontSize="14" FontWeight="Bold">
                                <ComboBoxItem Content="Player"/>
                                <ComboBoxItem Content="Admin"/>
                            </ComboBox>
                            <Button Content="👑 APLICĂ ROL" Width="120" Height="40" Click="BtnUpdateRole_Click" Background="#FFD700" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header=" 🎰 SLOT MANAGER " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="20" Margin="0,0,15,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CREEAZĂ / EDITEAZĂ SLOT" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                                <TextBlock Text="Nume Joc:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtSlotName" Margin="0,0,0,15" Height="35" FontSize="14"/>

                                <TextBlock Text="Thumbnail (Poza Lobby):" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <DockPanel Margin="0,0,0,15">
                                    <Button Content="📁" Width="40" Height="35" DockPanel.Dock="Right" Click="BtnUploadPhoto_Click" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0"/>
                                    <TextBox x:Name="TxtSlotThumb" Height="35" IsReadOnly="True" Background="#1A1B22" Foreground="#888" Text="Selectează o poză..."/>
                                </DockPanel>

                                <TextBlock Text="Simboluri Joc (minim 3):" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Button x:Name="BtnUploadSymbols" Content="➕ Adaugă Simbol Nou" Height="40" Click="BtnUploadSymbols_Click" Background="#2A2B35" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>

                                <ListBox x:Name="LstConfiguredSymbols" Height="150" Margin="0,0,0,15" Background="#0A0A0C" BorderBrush="#2A2B35" BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Width="280" Margin="0,5">
                                                <Button Content="✕" DockPanel.Dock="Right" Foreground="#E53935" Background="Transparent" BorderThickness="0" FontWeight="Bold" Click="BtnRemoveSymbolFromList_Click" Tag="{Binding}" Margin="10,0,0,0" Cursor="Hand" FontSize="16"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ImageName}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock FontSize="11" Foreground="#888">
                                                        <Run Text="3x: "/><Run Text="{Binding Multiplier3}" Foreground="#00E676"/>
                                                        <Run Text=" | 4x: "/><Run Text="{Binding Multiplier4}" Foreground="#00E676"/>
                                                        <Run Text=" | 5x: "/><Run Text="{Binding Multiplier5}" Foreground="#00E676"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Culoare Temă (Hex: #RRGGBB):" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtSlotColor" Text="#1E1E1E" Margin="0,0,0,15" Height="35" FontSize="14" FontWeight="Bold"/>

                                <UniformGrid Columns="2" Margin="0,0,0,15">
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="Rânduri:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSlotRows" Text="3" Height="35" TextAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="Coloane:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSlotCols" Text="5" Height="35" TextAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="Linii de plată:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtSlotPaylines" Text="20" Margin="0,0,0,15" Height="35" FontSize="14" FontWeight="Bold"/>

                                <TextBlock Text="Tip Wild (Mecanică):" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbWildType" Margin="0,0,0,25" Height="35" SelectedIndex="0" FontSize="14" FontWeight="Bold">
                                    <ComboBoxItem Content="Classic_1x1"/>
                                    <ComboBoxItem Content="Expand_Column"/>
                                    <ComboBoxItem Content="Spread_3x3"/>
                                </ComboBox>

                                <Button Content="🚀 SALVEAZĂ JOCUL" Height="50" Background="#00E676" Foreground="Black" FontSize="16" FontWeight="Black" Click="BtnAddSlot_Click" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Baza de date Jocuri Slot" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                            <DataGrid x:Name="SlotsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="SlotsGrid_SelectionChanged" SelectionMode="Single" Margin="0,0,0,15">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Nume Joc" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Linii" Binding="{Binding Paylines}" Width="80"/>
                                    <DataGridTextColumn Header="Status Activ" Binding="{Binding IsActive}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🗑️ ȘTERGE SLOT" Click="BtnDeleteSlot_Click" Background="#E53935" Foreground="White" FontWeight="Bold" Width="140" Height="40" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="➕ ADUGĂ NOU" Click="BtnNewMode_Click" Background="#2A2B35" Foreground="White" FontWeight="Bold" Width="140" Height="40" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header=" ⚽ PARIURI SPORTIVE " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="20" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="ADAUGĂ MECI NOU" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                            <TextBlock Text="Echipa Gazdă (Home):" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtHomeTeam" Margin="0,0,0,15" Height="35" FontSize="14"/>

                            <TextBlock Text="Echipa Oaspete (Away):" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtAwayTeam" Margin="0,0,0,20" Height="35" FontSize="14"/>

                            <TextBlock Text="Setare Cote (1, X, 2):" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <UniformGrid Columns="3" Margin="0,0,0,30">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="1 (Gazde)" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtOdds1" Text="1.00" Height="40" FontSize="16" FontWeight="Black" TextAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,5,0">
                                    <TextBlock Text="X (Egal)" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtOddsX" Text="1.00" Height="40" FontSize="16" FontWeight="Black" TextAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock Text="2 (Oaspeți)" Foreground="#888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtOdds2" Text="1.00" Height="40" FontSize="16" FontWeight="Black" TextAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>

                            <Button Content="✅ PUBLICĂ OFERTĂ" Height="50" Background="#2979FF" Foreground="White" FontSize="16" FontWeight="Black" Click="BtnAddMatch_Click" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect Color="#2979FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Meciuri Active (În Așteptare)" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                            <DataGrid x:Name="MatchesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" Margin="0,0,0,15">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                    <DataGridTextColumn Header="Echipa Gazdă" Binding="{Binding HomeTeam}" Width="*"/>
                                    <DataGridTextColumn Header="Echipa Oaspete" Binding="{Binding AwayTeam}" Width="*"/>
                                    <DataGridTextColumn Header="Cota 1" Binding="{Binding Odds1}" Width="70"/>
                                    <DataGridTextColumn Header="Cota X" Binding="{Binding OddsX}" Width="70"/>
                                    <DataGridTextColumn Header="Cota 2" Binding="{Binding Odds2}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 REFRESH" Click="BtnRefreshMatches_Click" Background="#2A2B35" Foreground="White" FontWeight="Bold" Width="120" Height="40" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="🎲 SIMULEAZĂ MECI" Click="BtnSimulateMatch_Click" Background="#FFD700" Foreground="Black" FontSize="14" FontWeight="Black" Width="180" Height="40" ToolTip="Generează scorul și plătește biletele!" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Effect>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                    </Button.Effect>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header=" 🧠 TRIVIADOR DB " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="20" Margin="0,0,15,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="ADAUGĂ ÎNTREBARE NOUĂ" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                                <TextBlock Text="Categorie:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbTriviaCategory" Margin="0,0,0,15" Height="35" FontSize="14" FontWeight="Bold">
                                    <ComboBoxItem Content="Istorie"/>
                                    <ComboBoxItem Content="Geografie"/>
                                    <ComboBoxItem Content="Sport"/>
                                    <ComboBoxItem Content="Artă"/>
                                    <ComboBoxItem Content="Știință"/>
                                    <ComboBoxItem Content="Diverse"/>
                                </ComboBox>

                                <TextBlock Text="Tip Întrebare:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbTriviaType" Margin="0,0,0,15" Height="35" SelectionChanged="CmbTriviaType_SelectionChanged" FontSize="14" FontWeight="Bold">
                                    <ComboBoxItem Content="Grilă (4 Variante)" Tag="2" IsSelected="True"/>
                                    <ComboBoxItem Content="Aproximare (Număr)" Tag="1"/>
                                </ComboBox>

                                <TextBlock Text="Text Întrebare:" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtTriviaText" Margin="0,0,0,15" Height="70" TextWrapping="Wrap" FontSize="14"/>

                                <StackPanel x:Name="PanelTriviaOptions">
                                    <TextBlock Text="Varianta A:" Foreground="#888" FontWeight="Bold"/>
                                    <TextBox x:Name="TxtTriviaA" Margin="0,0,0,10" Height="30"/>
                                    <TextBlock Text="Varianta B:" Foreground="#888" FontWeight="Bold"/>
                                    <TextBox x:Name="TxtTriviaB" Margin="0,0,0,10" Height="30"/>
                                    <TextBlock Text="Varianta C:" Foreground="#888" FontWeight="Bold"/>
                                    <TextBox x:Name="TxtTriviaC" Margin="0,0,0,10" Height="30"/>
                                    <TextBlock Text="Varianta D:" Foreground="#888" FontWeight="Bold"/>
                                    <TextBox x:Name="TxtTriviaD" Margin="0,0,0,20" Height="30"/>
                                </StackPanel>

                                <TextBlock Text="RĂSPUNS CORECT:" Foreground="#00E676" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtTriviaCorrect" Margin="0,0,0,25" Height="40" FontSize="18" TextAlignment="Center" FontWeight="Black" BorderBrush="#00E676" BorderThickness="2"/>

                                <Button Content="➕ SALVEAZĂ ÎN BAZA DE DATE" Click="BtnAddTrivia_Click" Height="50" Background="#1E7A34" Foreground="White" FontSize="16" FontWeight="Black" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Baza de Date Întrebări Trivia" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                            <DataGrid x:Name="TriviaGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="100"/>
                                    <DataGridTextColumn Header="Întrebare" Binding="{Binding Text}" Width="*"/>
                                    <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="40"/>
                                    <DataGridTextColumn Header="Răsp. Corect" Binding="{Binding CorrectAnswer}" Width="100"/>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" Click="BtnDeleteTrivia_Click" Tag="{Binding Id}" Background="Transparent" Foreground="Red" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="2" Content="🔄 REFRESH BAZA DE DATE" Click="BtnRefreshTrivia_Click" Height="40" Width="200" HorizontalAlignment="Right" Background="#2A2B35" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>