<Window x:Class="LoseBet.Desktop.BlackJackLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet Lobby" Height="600" Width="1000" WindowStartupLocation="CenterScreen" Background="#0B0B0B">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
        <Style x:Key="GameCard" TargetType="Button">
            <Setter Property="Width" Value="360"/>
            <Setter Property="Height" Value="300"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="18" Background="{TemplateBinding Background}" BorderThickness="3" BorderBrush="#222" Padding="18">
                            <ContentPresenter ContentSource="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="18" Background="#0F0F0F" BorderBrush="#FFD700" BorderThickness="2" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button Content="← DASHBOARD" Click="BtnBack_Click" Width="120" Height="36" DockPanel.Dock="Left" Background="#111" Foreground="#FFD700" BorderBrush="#333"/>
                    <TextBlock Text="LOSEBET LOBBY" FontSize="28" FontWeight="Black" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="#00E676" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="ALEGE O MASĂ PENTRU A JUCA" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>

                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Button x:Name="BtnPlayClassic" Style="{StaticResource GameCard}" Background="#0b6b2f" Click="BtnPlayClassic_Click">
                                <Button.Content>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="CLASSIC" FontSize="16" Foreground="#FFD700" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Blackjack" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <Border Background="#083" CornerRadius="8" Padding="10" Margin="0,24,0,0">
                                            <TextBlock Text="Miza Minimă: 10 RON" FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Button x:Name="BtnPlayVIP" Style="{StaticResource GameCard}" Background="#4A0000" Click="BtnPlayVIP_Click">
                                <Button.Content>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="VIP EXCLUSIVE" FontSize="16" Foreground="#FFD700" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Pro Blackjack" FontSize="40" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <Border Background="#330000" CornerRadius="8" Padding="10" Margin="0,24,0,0" BorderBrush="#FFD700" BorderThickness="2">
                                            <TextBlock Text="Miza Minimă: 500 RON" FontSize="14" Foreground="#FFD700" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- no giftbox in lobby -->
            </Grid>
        </Border>
    </Grid>
</Window>
