<Window x:Class="LoseBet.Desktop.BlackJackLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Lobby Blackjack" Height="650" Width="1000" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <Storyboard x:Key="WindowLoadAnim">
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowLoadAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder" CornerRadius="20" BorderBrush="#FFD700" BorderThickness="2" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="MainScale"/>
        </Border.RenderTransform>
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#1A1A1A" Offset="0"/>
                <GradientStop Color="#050505" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Button Content="⬅ DASHBOARD" Click="BtnBack_Click" Width="130" Height="35" HorizontalAlignment="Left" Background="#111" Foreground="#FFD700" FontWeight="Bold" BorderBrush="#FFD700" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="LOSE" Foreground="#FFD700" FontSize="26" FontWeight="Black"/>
                    <TextBlock Text="BET" Foreground="White" FontSize="26" FontWeight="Light"/>
                    <TextBlock Text=" LOBBY" Foreground="#888" FontSize="26" FontWeight="Bold"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#22000000" CornerRadius="10" BorderBrush="#333" BorderThickness="1" Padding="15,5">
                    <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" Foreground="#00FF00" FontSize="20" FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="LimeGreen" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>
            </Grid>

            <TextBlock Grid.Row="1" Text="ALEGE O MASĂ PENTRU A JUCA" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,40"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Click="BtnPlayClassic_Click" Width="300" Height="400" Margin="20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CardGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <Border x:Name="CardBg" CornerRadius="20" BorderBrush="#00FF00" BorderThickness="1" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#004D00" Offset="0"/>
                                            <GradientStop Color="#001A00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.7"/>
                                    </Border.Effect>

                                    <Grid>
                                        <TextBlock Text="🃏" FontSize="150" Foreground="White" Opacity="0.1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

                                        <StackPanel VerticalAlignment="Bottom" Margin="20,20,20,45">
                                            <TextBlock Text="🃏" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="CLASSIC" Foreground="#00FF00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Blackjack" Foreground="White" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                            <Border Background="#11000000" CornerRadius="8" Padding="10" BorderBrush="#3300FF00" BorderThickness="1">
                                                <TextBlock Text="Miza Minimă: 10 RON" Foreground="LightGray" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="HoverGlow" CornerRadius="20" BorderBrush="#00FF00" BorderThickness="3" Opacity="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00FF00" BlurRadius="25" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                                </Trigger>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="BtnPlayVIP_Click" Width="300" Height="400" Margin="20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CardGrid2" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <Border x:Name="CardBg2" CornerRadius="20" BorderBrush="#FFD700" BorderThickness="2" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#660000" Offset="0"/>
                                            <GradientStop Color="#1A0000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.7"/>
                                    </Border.Effect>

                                    <Grid>
                                        <TextBlock Text="👑" FontSize="150" Foreground="#FFD700" Opacity="0.1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

                                        <StackPanel VerticalAlignment="Bottom" Margin="20,20,20,45">
                                            <TextBlock Text="👑" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Gold" BlurRadius="10" ShadowDepth="0"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="VIP EXCLUSIVE" Foreground="#FFD700" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Blackjack" Foreground="White" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                            <Border Background="#22000000" CornerRadius="8" Padding="10" BorderBrush="#44FFD700" BorderThickness="1">
                                                <TextBlock Text="Miza Minimă: 500 RON" Foreground="#FFD700" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="HoverGlow2" CornerRadius="20" BorderBrush="#FFD700" BorderThickness="3" Opacity="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="30" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverGlow2" Property="Opacity" Value="1"/>
                                </Trigger>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardGrid2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>