<Window x:Class="LoseBet.Desktop.TriviadorLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Triviador Lobby" Height="600" Width="800" WindowStartupLocation="CenterScreen" Background="#2C3E50">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button Content="⬅ Înapoi la Dashboard" Click="BtnBack_Click" Width="150" Height="30" HorizontalAlignment="Left" Background="#34495E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" FontSize="20" FontWeight="Bold" Foreground="Gold" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="CONFIGURARE MECI TRIVIADOR" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10">
                    <TextBlock Text="1. Alege Miza (RON)" Foreground="LightGray" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="CmbBetAmount" FontSize="16" Height="30">
                        <ComboBoxItem Content="10" IsSelected="True"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                        <ComboBoxItem Content="200"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10">
                    <TextBlock Text="2. Număr Adversari" Foreground="LightGray" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <RadioButton x:Name="Rb1Bot" Content="1 Bot (Câștig x4)" Foreground="White" FontSize="14" IsChecked="True" Margin="0,5"/>
                    <RadioButton x:Name="Rb2Bots" Content="2 Boți (Câștig x3 / x1)" Foreground="White" FontSize="14" Margin="0,5"/>
                    <RadioButton x:Name="Rb5Bots" Content="5 Boți (Turneu Epic)" Foreground="White" FontSize="14" Margin="0,5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10">
                    <TextBlock Text="3. Categorii Întrebări" Foreground="LightGray" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkSport" Content="Sport" Foreground="White" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkGeo" Content="Geografie (Județe)" Foreground="White" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkIstorie" Content="Istoria României" Foreground="White" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkArta" Content="Artă și Cultură" Foreground="White" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkPoeti" Content="Mari Poeți" Foreground="White" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkStiinta" Content="Știință și Natură" Foreground="White" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkDiverse" Content="Diverse / Random" Foreground="White" IsChecked="True" Margin="0,2"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Button Grid.Row="2" Content="⚔️ INTRĂ ÎN ARENĂ (START JOC)" Click="BtnStartGame_Click" Width="300" Height="50" Background="DarkRed" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Cursor="Hand" Margin="0,20,0,0"/>
    </Grid>
</Window>