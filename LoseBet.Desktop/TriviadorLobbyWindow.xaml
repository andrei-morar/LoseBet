<Window x:Class="LoseBet.Desktop.TriviadorLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Triviador Lobby" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0A0A0C">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="RedGlow" Color="#E53935" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

        <Style TargetType="Button" x:Key="QuickBtnStyle">
            <Setter Property="Background" Value="#1A1B22"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252630"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="#111115" BorderBrush="#222" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Button Content="◄ LOBBY" Width="100" Height="35" HorizontalAlignment="Left" Click="BtnBack_Click" Background="#222" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="T R I V I A D O R   A R E N A" Foreground="#FFD700" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Sold curent: " Foreground="#888" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="#00E676" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT (CONFIGURARE) ================= -->
        <Border Grid.Row="1" Background="#14151A" Margin="20" CornerRadius="15" BorderBrush="#2A2B35" BorderThickness="2" ClipToBounds="True">
            <Grid>
                <!-- Lumina ambientala rosiatica -->
                <Ellipse Width="600" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.03">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#E53935" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CONFIGURARE MECI" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLOANA 1: MIZA -->
                        <StackPanel Grid.Column="0" Margin="15">
                            <TextBlock Text="1. MIZĂ (RON)" Foreground="#888" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <Button Content="½" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="0.5" Click="QuickBet_Click"/>
                                <Button Content="1x" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="1" Click="QuickBet_Click"/>
                                <Button Content="2x" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="2" Click="QuickBet_Click"/>
                                <Button Content="MAX" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="max" Click="QuickBet_Click"/>
                            </StackPanel>

                            <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="-" Width="45" Height="45" Background="#252630" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnLowerBet_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBox x:Name="TxtBet" Text="10.00" Width="100" Height="45" FontSize="22" TextAlignment="Center" FontWeight="Black" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                                    <Button Content="+" Width="45" Height="45" Background="#252630" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnHigherBet_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- COLOANA 2: NUMĂR ADVERSARI -->
                        <StackPanel Grid.Column="1" Margin="15">
                            <TextBlock Text="2. ADVERSARI" Foreground="#888" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                            <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <RadioButton x:Name="Rb1Bot" Content="1 Bot (Câștig x4)" Foreground="White" FontSize="15" FontWeight="SemiBold" IsChecked="True" Margin="0,10"/>
                                    <RadioButton x:Name="Rb2Bots" Content="2 Boți (Câștig x3 / x1)" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,10"/>
                                    <RadioButton x:Name="Rb5Bots" Content="5 Boți (Turneu Epic)" Foreground="#FFD700" FontSize="15" FontWeight="Bold" Margin="0,10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- COLOANA 3: CATEGORII ÎNTREBĂRI -->
                        <StackPanel Grid.Column="2" Margin="15">
                            <TextBlock Text="3. CATEGORII" Foreground="#888" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                            <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSport" Content="Sport" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                    <CheckBox x:Name="ChkGeo" Content="Geografie (Județe)" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                    <CheckBox x:Name="ChkIstorie" Content="Istoria României" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                    <CheckBox x:Name="ChkArta" Content="Artă și Cultură" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                    <CheckBox x:Name="ChkPoeti" Content="Mari Poeți" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                    <CheckBox x:Name="ChkStiinta" Content="Știință și Natură" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                    <CheckBox x:Name="ChkDiverse" Content="Diverse / Random" Foreground="White" FontSize="14" IsChecked="True" Margin="0,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= FOOTER (BUTON START) ================= -->
        <Border Grid.Row="2" Background="#111115" BorderBrush="#222" BorderThickness="0,2,0,0">
            <Button Content="⚔️ INTRĂ ÎN ARENĂ" Click="BtnStartGame_Click" Width="350" Height="70" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B71C1C" Offset="0"/>
                        <GradientStop Color="#E53935" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#E53935" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                </Button.Effect>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <Button.Foreground>White</Button.Foreground>
                <Button.FontSize>24</Button.FontSize>
                <Button.FontWeight>Black</Button.FontWeight>
            </Button>
        </Border>
    </Grid>
</Window>