<Window x:Class="LoseBet.Desktop.SlotEngineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slot Game" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="#111">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Background="#222" Padding="20,10">
            <DockPanel>
                <Button Content="✕" Click="BtnExit_Click" Width="30" Background="Red" Foreground="White" BorderThickness="0"/>
                <TextBlock x:Name="TxtGameName" Text="SLOT NAME" Foreground="Gold" FontSize="20" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="SOLD: " Foreground="White" VerticalAlignment="Center" FontSize="18"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="Lime" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="20" BorderBrush="#444" BorderThickness="2" Background="Black">
            <UniformGrid x:Name="SlotGrid" />
        </Border>

        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#333" BorderThickness="0,2,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLastWin" Text="CÂȘTIG: 0.00" Foreground="Gold" FontSize="22" FontWeight="Bold" Visibility="Hidden"/>
                    <Button x:Name="BtnGamble" Content="DUBLAJ (x2)" Background="DarkRed" Foreground="White" Height="40" Margin="0,5,0,0" Click="BtnGamble_Click" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="-" Click="BtnLowerBet_Click" Width="40" Height="40" FontSize="20" Background="#333" Foreground="White"/>
                    <Border Background="Black" BorderBrush="Gold" BorderThickness="1" Width="150" Height="50" Margin="10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MIZĂ" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentBet" Text="0.20" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="+" Click="BtnHigherBet_Click" Width="40" Height="40" FontSize="20" Background="#333" Foreground="White"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnSpin" Content="SPIN" Background="DarkGreen" Foreground="White" FontSize="24" FontWeight="Black" Height="70" Width="180" Click="BtnSpin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>