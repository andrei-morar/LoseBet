<Window x:Class="LoseBet.Desktop.AviatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Aviator Pro" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0A0A0C">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        <Style TargetType="Button" x:Key="QuickBtnStyle">
            <Setter Property="Background" Value="#1A1B22"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#2A2B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252630"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111115" BorderBrush="#222" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <ItemsControl x:Name="HistoryPanel" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding ColorCode}" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Value, StringFormat='{}{0:F2}x'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Sold curent: " Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="#00E676" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#14151A" Margin="20" CornerRadius="15" BorderBrush="#2A2B35" BorderThickness="2" ClipToBounds="True">
            <Grid>
                <Grid x:Name="BackgroundGrid" Opacity="0.05">
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="5,5" Data="M 0,350 L 1000,350" Margin="0,50,0,0"/>
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="5,5" Data="M 0,250 L 1000,250" Margin="0,150,0,0"/>
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="5,5" Data="M 0,150 L 1000,150" Margin="0,250,0,0"/>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10">
                    <TextBlock x:Name="MultiplierDisplay" Text="1.00x" FontSize="110" FontWeight="Black" Foreground="White" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Text="A Ș T E P T A R E   P A R I U R I" FontSize="20" Foreground="#FF9800" HorizontalAlignment="Center" FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF9800" BlurRadius="10" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <ProgressBar x:Name="WaitProgressBar" Width="350" Height="6" Margin="0,20,0,0" Background="#222" Foreground="#FF9800" Minimum="0" Maximum="100" BorderThickness="0"/>
                </StackPanel>

                <Border x:Name="CashoutBanner" Visibility="Collapsed" Background="#D800E676" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,15" Panel.ZIndex="20" Margin="0,150,0,0">
                    <TextBlock x:Name="CashoutBannerText" Text="CASHOUT" Foreground="Black" FontSize="24" FontWeight="Black"/>
                </Border>

                <Canvas x:Name="FlightCanvas" ClipToBounds="True">
                    <Path x:Name="FlightFill" Fill="#15E53935" StrokeThickness="0"/>
                    <Path x:Name="FlightPath" Stroke="#E53935" StrokeThickness="5">
                        <Path.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                        </Path.Effect>
                    </Path>
                    <TextBlock x:Name="PlaneIcon" Text="✈" FontSize="50" Canvas.Left="20" Canvas.Top="350" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="PlaneBrush" Color="#E53935"/>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="PlaneRotation" Angle="-10"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#111115" BorderBrush="#222" BorderThickness="0,2,0,0">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,40,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="MIZĂ" Foreground="#888" FontSize="12" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <Button x:Name="QBtn1" Content="½" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="0.5" Click="QuickBet_Click"/>
                        <Button x:Name="QBtn2" Content="1x" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="1" Click="QuickBet_Click"/>
                        <Button x:Name="QBtn3" Content="2x" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="2" Click="QuickBet_Click"/>
                        <Button x:Name="QBtn4" Content="MAX" Style="{StaticResource QuickBtnStyle}" Margin="2,0" Tag="max" Click="QuickBet_Click"/>
                    </StackPanel>
                    <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Width="45" Height="45" Background="#252630" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnLowerBet_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBox x:Name="BetInput" Text="10.00" Width="100" Height="45" FontSize="20" TextAlignment="Center" FontWeight="Black" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                            <Button Content="+" Width="45" Height="45" Background="#252630" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnHigherBet_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnBet" Width="320" Height="80" Click="BtnBet_Click" Cursor="Hand" BorderThickness="0" Margin="0,0,40,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="BtnGradStart" Color="#1E7A34" Offset="0"/>
                            <GradientStop x:Name="BtnGradEnd" Color="#28A745" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Effect>
                        <DropShadowEffect x:Name="BtnGlow" Color="#00E676" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Button.Effect>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel x:Name="BtnBetContent" VerticalAlignment="Center">
                        <TextBlock x:Name="BtnBetMainText" Text="PARIAZĂ" HorizontalAlignment="Center" Foreground="White" FontSize="28" FontWeight="Black"/>
                        <TextBlock x:Name="BtnBetSubText" Text="Câștig: 0.00 RON" Foreground="White" FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0.9"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <CheckBox x:Name="ChkAutoCashout" Content="AUTO CASHOUT" Foreground="#888" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    <Border Background="#1A1B22" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="5" Width="120">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="x" Foreground="#555" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="AutoCashoutInput" Text="2.00" Width="70" Height="45" FontSize="20" TextAlignment="Center" FontWeight="Black" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>