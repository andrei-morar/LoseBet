<Window x:Class="LoseBet.Desktop.AviatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Aviator Pro" Height="550" Width="800" Background="#14151a" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1b1c24" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="HistoryPanel" VerticalAlignment="Center" Margin="10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding ColorCode}" CornerRadius="15" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Value, StringFormat='{}{0:F2}x'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Column="1" x:Name="TxtBalance" Text="0.00 RON" Foreground="#ff0000" FontSize="18" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,20,0"/>
        </Grid>

        <Border Grid.Row="1" Background="#111116" Margin="10" CornerRadius="10" BorderBrush="#2c2d35" BorderThickness="2" ClipToBounds="True">
            <Grid>
                <Grid x:Name="BackgroundGrid" Opacity="0.1">
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="5,5" Data="M 0,300 L 800,300" Margin="0,50,0,0"/>
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="5,5" Data="M 0,200 L 800,200" Margin="0,150,0,0"/>
                    <Path Stroke="White" StrokeThickness="1" StrokeDashArray="5,5" Data="M 0,100 L 800,100" Margin="0,250,0,0"/>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10">
                    <TextBlock x:Name="MultiplierDisplay" Text="1.00x" FontSize="100" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Opacity="0.9">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Text="Așteptare pariuri..." FontSize="24" Foreground="#888888" HorizontalAlignment="Center" Margin="0,-10,0,0" FontWeight="Bold"/>

                    <ProgressBar x:Name="WaitProgressBar" Width="300" Height="8" Margin="0,15,0,0" Background="#333" Foreground="#E53935" Minimum="0" Maximum="100" Visibility="Hidden"/>
                </StackPanel>

                <Canvas x:Name="FlightCanvas" ClipToBounds="True">
                    <Path x:Name="FlightPath" Stroke="#E53935" StrokeThickness="4" Fill="#33E53935">
                        <Path.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="15" ShadowDepth="0"/>
                        </Path.Effect>
                    </Path>

                    <TextBlock x:Name="PlaneIcon" Text="✈" FontSize="40" Foreground="#E53935" Canvas.Left="0" Canvas.Top="350">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="10" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1b1c24" Padding="15" BorderBrush="#2c2d35" BorderThickness="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Miză (RON)" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <Border Background="#111116" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Width="35" Height="35" Background="#2c2d35" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnLowerBet_Click"/>
                            <TextBox x:Name="BetInput" Text="10.00" Width="80" Height="35" FontSize="18" TextAlignment="Center" FontWeight="Bold" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                            <Button Content="+" Width="35" Height="35" Background="#2c2d35" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnHigherBet_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoCashout" Content="Auto Cashout" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5" VerticalContentAlignment="Center"/>
                    <Border Background="#111116" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="x" Foreground="Gray" FontSize="18" VerticalAlignment="Center" Margin="15,0,5,0"/>
                            <TextBox x:Name="AutoCashoutInput" Text="2.00" Width="60" Height="35" FontSize="18" TextAlignment="Center" FontWeight="Bold" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="BtnBet" Width="300" Height="65" Background="#28a745" Foreground="White" FontSize="26" FontWeight="Black" Click="BtnBet_Click" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel x:Name="BtnBetContent">
                        <TextBlock x:Name="BtnBetMainText" Text="PARIAZĂ" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BtnBetSubText" Text="" FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>