<Window x:Class="LoseBet.Desktop.MinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Mines Pro" Height="500" Width="700" Background="#1A1A1A" WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="#252526" Padding="15">
			<StackPanel>
				<TextBlock x:Name="TxtBalance" Text="Balanță: 1000.00" Foreground="#4CAF50" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

				<TextBlock Text="Miza (RON):" Foreground="#AAAAAA" Margin="0,0,0,5"/>
				<TextBox x:Name="BetInput" Text="10" FontSize="18" Padding="5" Margin="0,0,0,15" Background="#333333" Foreground="White" BorderThickness="0"/>

				<TextBlock Text="Număr Mine (1-24):" Foreground="#AAAAAA" Margin="0,0,0,5"/>
				<ComboBox x:Name="MinesCountCombo" FontSize="16" Padding="5" Margin="0,0,0,20">
					<ComboBoxItem Content="1" />
					<ComboBoxItem Content="3" IsSelected="True" />
					<ComboBoxItem Content="5" />
					<ComboBoxItem Content="10" />
					<ComboBoxItem Content="20" />
				</ComboBox>

				<Border Background="#111111" Padding="10" CornerRadius="5" Margin="0,0,0,20">
					<TextBlock x:Name="MultiplierText" Text="1.00x" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
				</Border>

				<Button x:Name="BtnPlay" Content="PARIAZĂ" Height="50" Background="#007ACC" Foreground="White" FontSize="18" FontWeight="Bold" Click="BtnPlay_Click" BorderThickness="0" Margin="0,0,0,10"/>
				<Button x:Name="BtnCashout" Content="CASHOUT" Height="50" Background="#4CAF50" Foreground="White" FontSize="18" FontWeight="Bold" IsEnabled="False" Click="BtnCashout_Click" BorderThickness="0"/>
			</StackPanel>
		</Border>

		<Border Grid.Column="1" Background="#1E1E1E" Margin="20" CornerRadius="10" Padding="10">
			<UniformGrid x:Name="MinesGrid" Rows="5" Columns="5"/>
		</Border>
	</Grid>
</Window>