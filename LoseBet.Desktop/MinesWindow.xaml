<Window x:Class="LoseBet.Desktop.MinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Mines" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0B0B0B">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow"   Color="#FFD700" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="GreenGlow"  Color="#00E676" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="RedGlow"    Color="#FF3333" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="BlueGlow"   Color="#2979FF" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="DarkShadow" Color="Black"   BlurRadius="12" ShadowDepth="4" Opacity="0.8"/>

        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Background"       Value="#1C2B3A"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontSize"         Value="28"/>
            <Setter Property="Margin"           Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#2A3F52"
                                BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background"    Value="#243545"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush"   Value="#FFD700"/>
                                <Setter TargetName="TileBorder" Property="Effect"        Value="{StaticResource NeonGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickBetBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1A1A1A"/>
            <Setter Property="Foreground"      Value="#FFD700"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderBrush"     Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#2A2A2A"/>
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#050505" BorderBrush="#222" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Button Content="◄ ÎNAPOI LA LOBBY"
                        Width="170" Height="35" HorizontalAlignment="Left"
                        Click="BtnBack_Click"
                        Background="Transparent" Foreground="#888"
                        BorderBrush="#333" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💣" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="M I N E S" Foreground="#FFD700" FontSize="24" FontWeight="Black"
                               VerticalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Sold curent: " Foreground="#888" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON"
                               Foreground="#00E676" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <TextBlock Text="MIZĂ (RON)" Foreground="#666" FontSize="11"
                                   FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,8">
                            <TextBox x:Name="BetInput" Text="10.00"
                                     FontSize="22" FontWeight="Black"
                                     TextAlignment="Center"
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0" Padding="10,10"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <WrapPanel Margin="0,0,0,18" HorizontalAlignment="Center">
                            <Button Content="1x" Style="{StaticResource QuickBetBtn}" Margin="3,2" Click="QuickBet_Click" Tag="1"/>
                            <Button Content="2x" Style="{StaticResource QuickBetBtn}" Margin="3,2" Click="QuickBet_Click" Tag="2"/>
                            <Button Content="½"  Style="{StaticResource QuickBetBtn}" Margin="3,2" Click="QuickBet_Click" Tag="0.5"/>
                            <Button Content="MAX" Style="{StaticResource QuickBetBtn}" Margin="3,2" Click="QuickBet_Click" Tag="max"/>
                        </WrapPanel>

                        <TextBlock Text="NUMĂR MINE" Foreground="#666" FontSize="11"
                                   FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,18">
                            <ComboBox x:Name="MinesCountCombo"
                                      FontSize="16" FontWeight="Bold"
                                      Background="Transparent" Foreground="White"
                                      BorderThickness="0" Padding="10,8" Margin="2"
                                      SelectionChanged="MinesCountCombo_SelectionChanged">
                                <ComboBoxItem Content="1 mină"  Tag="1"/>
                                <ComboBoxItem Content="3 mine"  Tag="3" IsSelected="True"/>
                                <ComboBoxItem Content="5 mine"  Tag="5"/>
                                <ComboBoxItem Content="10 mine" Tag="10"/>
                                <ComboBoxItem Content="20 mine" Tag="20"/>
                            </ComboBox>
                        </Border>

                        <Rectangle Height="1" Fill="#1E1E1E" Margin="0,0,0,18"/>

                        <TextBlock Text="MULTIPLICATOR" Foreground="#666" FontSize="11"
                                   FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#0A1628" BorderBrush="#1A2A3A" BorderThickness="1"
                                CornerRadius="10" Padding="0,14" Margin="0,0,0,10">
                            <TextBlock x:Name="MultiplierText" Text="—"
                                       Foreground="#FFD700" FontSize="30" FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       Effect="{StaticResource NeonGlow}"/>
                        </Border>

                        <Border Background="#0A1A0A" BorderBrush="#1A2A1A" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Câștig potențial: " Foreground="#555" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPotential" Text="0.00 RON"
                                           Foreground="#00E676" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                    CornerRadius="6" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="DEZV." Foreground="#555" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtRevealed" Text="0"
                                               Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                    CornerRadius="6" Padding="14,8">
                                <StackPanel>
                                    <TextBlock Text="MINE" Foreground="#555" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtMineCount" Text="3"
                                               Foreground="#FF5252" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#1E1E1E" Margin="0,0,0,18"/>

                        <Button x:Name="BtnPlay"
                                Content="▶  PARIAZĂ"
                                Height="54" Margin="0,0,0,10"
                                Background="#FFD700" Foreground="Black"
                                FontSize="18" FontWeight="Black"
                                Click="BtnPlay_Click" BorderThickness="0" Cursor="Hand">
                            <Button.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                            </Button.Effect>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnCashout"
                                Content="💰  CASHOUT"
                                Height="54"
                                Background="#00C853" Foreground="White"
                                FontSize="18" FontWeight="Black"
                                IsEnabled="False"
                                Click="BtnCashout_Click" BorderThickness="0" Cursor="Hand">
                            <Button.Effect>
                                <DropShadowEffect Color="#00E676" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                            </Button.Effect>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#0F0F0F">
                <Grid>
                    <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.04">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFD700" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Border x:Name="StatusBorder"
                                Background="#111" BorderBrush="#222" BorderThickness="1"
                                CornerRadius="10" Padding="24,10" Margin="0,0,0,20"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtStatus"
                                       Text="SETEAZĂ MIZA ȘI APASĂ PARIAZĂ!"
                                       Foreground="#FFD700" FontSize="16" FontWeight="Bold"/>
                        </Border>

                        <Border Background="#080F16" BorderBrush="#1A2A3A" BorderThickness="1"
                                CornerRadius="14" Padding="10">
                            <UniformGrid x:Name="MinesGrid" Rows="5" Columns="5" Width="430" Height="430"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>