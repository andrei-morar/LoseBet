<Window x:Class="LoseBet.Desktop.AlbaNeagraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Alba Neagra" Height="500" Width="700" Background="#1a1a2e" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="100"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#16213e" Padding="15,0">
			<DockPanel VerticalAlignment="Center">
				<Button Content="⬅ Înapoi" Width="80" Height="30" Click="BtnBack_Click" Background="#0f3460" Foreground="White" BorderThickness="0" Cursor="Hand"/>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<TextBlock Text="Sold: " Foreground="White" FontSize="16" VerticalAlignment="Center"/>
					<TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="Gold" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
				</StackPanel>
				<TextBlock Text="🎩 ALBA-NEAGRA" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
			</DockPanel>
		</Border>

		<Grid Grid.Row="1">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock x:Name="TxtStatus" Text="Alege miza și apasă START!" Foreground="#e94560" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

				<Button x:Name="BtnStart" Content="▶ START JOC (Amestecă)" Height="45" Width="250" Background="#e94560" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnStart_Click" BorderThickness="0" Cursor="Hand" Margin="0,0,0,30"/>

				<Canvas x:Name="GameCanvas" Width="380" Height="150" HorizontalAlignment="Center">
					<StackPanel x:Name="Cup1" Canvas.Left="0" Canvas.Top="0" Width="100">
						<TextBlock x:Name="Ball1" Text="🔴" FontSize="40" HorizontalAlignment="Center" Visibility="Hidden" Margin="0,0,0,-20" Panel.ZIndex="0"/>
						<Button x:Name="BtnCup1" Content="🎩" Tag="1" FontSize="80" Background="Transparent" BorderThickness="0" Click="BtnCup_Click" Cursor="Hand" Panel.ZIndex="1" IsEnabled="False">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>

					<StackPanel x:Name="Cup2" Canvas.Left="140" Canvas.Top="0" Width="100">
						<TextBlock x:Name="Ball2" Text="🔴" FontSize="40" HorizontalAlignment="Center" Visibility="Hidden" Margin="0,0,0,-20" Panel.ZIndex="0"/>
						<Button x:Name="BtnCup2" Content="🎩" Tag="2" FontSize="80" Background="Transparent" BorderThickness="0" Click="BtnCup_Click" Cursor="Hand" Panel.ZIndex="1" IsEnabled="False">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>

					<StackPanel x:Name="Cup3" Canvas.Left="280" Canvas.Top="0" Width="100">
						<TextBlock x:Name="Ball3" Text="🔴" FontSize="40" HorizontalAlignment="Center" Visibility="Hidden" Margin="0,0,0,-20" Panel.ZIndex="0"/>
						<Button x:Name="BtnCup3" Content="🎩" Tag="3" FontSize="80" Background="Transparent" BorderThickness="0" Click="BtnCup_Click" Cursor="Hand" Panel.ZIndex="1" IsEnabled="False">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>
				</Canvas>
			</StackPanel>
		</Grid>

		<Border Grid.Row="2" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,3,0,0" Padding="15">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Miza (RON):" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="0,0,15,0"/>
				<Button Content="-" Width="40" Height="40" Background="#0f3460" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnLowerBet_Click"/>
				<TextBox x:Name="TxtBet" Text="10.00" Width="100" Height="40" FontSize="20" TextAlignment="Center" FontWeight="Bold" Background="#0a0a0a" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
				<Button Content="+" Width="40" Height="40" Background="#0f3460" Foreground="White" FontWeight="Bold" FontSize="20" BorderThickness="0" Click="BtnHigherBet_Click"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>