<Window x:Class="LoseBet.Desktop.WalletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Portofel / Casierie" Height="450" Width="600" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button Content="⬅ Înapoi la Dashboard" Click="BtnBack_Click" Width="150" Height="30" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand"/>
            <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" FontSize="20" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border BorderBrush="Black" BorderThickness="1" Padding="20" Width="250" Margin="0,0,20,0" Background="#f0f8ff">
                <StackPanel>
                    <TextBlock Text="DEPUNERE BANI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Suma de depus (RON):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDepositAmount" Height="25" Margin="0,0,0,15" TextAlignment="Center"/>
                    <Button Content="DEPUNE" Click="BtnDeposit_Click" Height="35" Background="LightGreen" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Black" BorderThickness="1" Padding="20" Width="250" Background="#fff0f5">
                <StackPanel>
                    <TextBlock Text="RETRAGERE BANI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Suma de retras (RON):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtWithdrawAmount" Height="25" Margin="0,0,0,5" TextAlignment="Center"/>
                    <TextBlock Text="*Se percepe comision 3%" FontSize="10" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Button Content="RETRAGE" Click="BtnWithdraw_Click" Height="35" Background="LightCoral" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Button x:Name="BtnBonus" Content="🎁 REVENDICĂ BONUS BUN VENIT (2000 RON) 🎁" Click="BtnBonus_Click" Height="40" Background="Gold" FontSize="14" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtStatus" Text="Alege o operațiune." HorizontalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>