<Window x:Class="LoseBet.Desktop.WalletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Casierie &amp; Oferte" Height="650" Width="1000" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0A0A0C">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="RedGlow" Color="#E53935" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="GreenGlow" Color="#00E676" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>

        <Style TargetType="Button" x:Key="PackageBtnStyle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="#14151A" BorderBrush="#2A2B35" BorderThickness="2" CornerRadius="15" Padding="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1A1B22"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="BgBorder" Property="Effect" Value="{StaticResource NeonGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="#111115" BorderBrush="#222" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Button Content="◄ ÎNAPOI LOBBY" Width="120" Height="35" HorizontalAlignment="Left" Click="BtnBack_Click" Background="#222" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="C A S I E R I E   &amp;   O F E R T E" Foreground="#FFD700" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Sold curent: " Foreground="#888" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="#00E676" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- ZONA STÂNGA: PACHETE DEPUNERE -->
            <Border Grid.Column="0" Background="#111115" CornerRadius="15" BorderBrush="#2A2B35" BorderThickness="1" Margin="0,0,10,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="OFERTE SPECIALE DE DEPUNERE" Foreground="White" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <UniformGrid Columns="3" Margin="0,0,0,25">

                        <!-- Pachet 1 -->
                        <Button Style="{StaticResource PackageBtnStyle}" Margin="5" Tag="50|0" Click="BtnPackage_Click">
                            <StackPanel>
                                <TextBlock Text="BRONZE" Foreground="#CD7F32" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="50 RON" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Margin="0,10"/>
                                <TextBlock Text="Fără bonus" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                                <Border Background="#CD7F32" CornerRadius="5" Padding="5,2" Margin="0,15,0,0">
                                    <TextBlock Text="CUMPĂRĂ" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Pachet 2 -->
                        <Button Style="{StaticResource PackageBtnStyle}" Margin="5" Tag="100|20" Click="BtnPackage_Click">
                            <StackPanel>
                                <TextBlock Text="SILVER" Foreground="#C0C0C0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="100 RON" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Margin="0,10"/>
                                <TextBlock Text="+ 20 RON BONUS" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border Background="#C0C0C0" CornerRadius="5" Padding="5,2" Margin="0,15,0,0">
                                    <TextBlock Text="CUMPĂRĂ" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Pachet 3 -->
                        <Button Style="{StaticResource PackageBtnStyle}" Margin="5" Tag="500|150" Click="BtnPackage_Click">
                            <StackPanel>
                                <TextBlock Text="VIP GOLD" Foreground="#FFD700" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
                                <TextBlock Text="500 RON" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Margin="0,10"/>
                                <TextBlock Text="+ 150 RON BONUS" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border Background="#FFD700" CornerRadius="5" Padding="5,2" Margin="0,15,0,0">
                                    <TextBlock Text="CUMPĂRĂ" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>

                    </UniformGrid>

                    <!-- Depunere Custom -->
                    <Border Background="#14151A" CornerRadius="10" BorderBrush="#2A2B35" BorderThickness="1" Padding="15" Margin="5,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Sumă personalizată:" Foreground="#888" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Border Background="#0A0A0C" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="5" Margin="0,0,15,0">
                                <TextBox x:Name="TxtDepositAmount" Width="100" Height="30" FontSize="18" TextAlignment="Center" FontWeight="Bold" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Content="DEPUNE MANUAL" Click="BtnDeposit_Click" Width="140" Height="40" Background="#1E7A34" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ZONA DREAPTA: RETRAGERE & BONUS -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">

                <!-- Retragere -->
                <Border Background="#111115" CornerRadius="15" BorderBrush="#2A2B35" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="RETRAGERE BANI" Foreground="White" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Suma de retras (RON):" Foreground="#888" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                        <Border Background="#0A0A0C" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="5" Margin="0,0,10,0" Width="150">
                            <TextBox x:Name="TxtWithdrawAmount" Height="30" FontSize="18" TextAlignment="Center" FontWeight="Bold" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="* Se percepe comision 3%" FontSize="11" Foreground="#E53935" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <Button Content="RETRAGE" Click="BtnWithdraw_Click" Width="180" Height="45" Background="#B71C1C" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <Button.Effect>
                                <DropShadowEffect Color="#E53935" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Bonus Bun Venit -->
                <Border Background="#1A1800" CornerRadius="15" BorderBrush="#FFD700" BorderThickness="2" Padding="20" Effect="{StaticResource NeonGlow}">
                    <StackPanel>
                        <TextBlock Text="GIFTBOX NOU!" Foreground="#FFD700" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Button x:Name="BtnBonus" Content="🎁 REVENDICĂ 2000 RON" Click="BtnBonus_Click" Height="55" Background="#FFD700" Foreground="Black" FontSize="16" FontWeight="Black" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="2" Background="#0A0A0C" BorderBrush="#222" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Alege o operațiune din casierie." Foreground="#888" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>