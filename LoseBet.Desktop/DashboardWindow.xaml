<Window x:Class="LoseBet.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Casino &amp; Sports" Height="800" Width="1200" WindowStartupLocation="CenterScreen"
        Background="#0B0B0B">

    <Window.Resources>
        <!-- Efect de neon / glow galben -->
        <DropShadowEffect x:Key="NeonGlow" Color="#FFD700" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>

        <!-- Butoane meniu sus -->
        <Style TargetType="Button" x:Key="TopMenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Butoane Filtre (tip Pilulă) - Păstrat în resurse în caz că vei avea nevoie de el în viitor -->
        <Style TargetType="Button" x:Key="PillButton">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carduri Jocuri (Stil Aurora) -->
        <Style TargetType="Button" x:Key="AuroraGameCard">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="5,10,15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="#141414" CornerRadius="12" BorderBrush="#222" BorderThickness="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="10,10,0,0">
                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontSize="50" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Grid Grid.Row="1" Background="#111">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="10,5,30,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Cazino / Noroc" Foreground="#777" FontSize="9" Margin="10,25,0,0"/>

                                    <Border Width="24" Height="24" Background="#FFD700" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="▶" Foreground="Black" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource NeonGlow}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TRUC PENTRU C# -->
        <StackPanel Visibility="Collapsed">
            <Button Click="BtnScrollEduLeft_Click"/>
            <Button Click="BtnScrollEduRight_Click"/>
            <Button Click="BtnScrollCasinoLeft_Click"/>
            <Button Click="BtnScrollCasinoRight_Click"/>
            <ScrollViewer x:Name="ScrollEdu"/>
            <ScrollViewer x:Name="ScrollCasino"/>
        </StackPanel>

        <!-- ================= HEADER SUPERIOR ================= -->
        <Border Grid.Row="0" Background="#050505" BorderBrush="#222" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="▲" Foreground="#FFD700" FontSize="35" Margin="0,0,5,0" Effect="{StaticResource NeonGlow}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LOSEBET" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,0,0,-4"/>
                        <TextBlock Text="C A S I N O" Foreground="#FFD700" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                        <Button Content="ACASĂ" Click="BtnMenuHome_Click" Style="{StaticResource TopMenuButton}" Foreground="#FFD700"/>
                        <Button Content="PĂCĂNELE" Click="BtnMenuCasino_Click" Style="{StaticResource TopMenuButton}"/>
                        <Button Content="CULTURĂ GENERALĂ" Click="BtnMenuEdu_Click" Style="{StaticResource TopMenuButton}"/>
                        <Button Content="LIVE CASINO" Click="BtnMenuLive_Click" Style="{StaticResource TopMenuButton}"/>
                        <Button Content="SPORT" Click="BtnMenuSports_Click" Style="{StaticResource TopMenuButton}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWelcome" Text="Salut, Jucător!" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 RON" Foreground="#FFD700" FontSize="16" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>

                    <Button Content="DELOGARE" Click="BtnLogout_Click" Width="90" Height="35" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="DEPUNERE" Click="BtnWallet_Click" Width="110" Height="35" Background="#FFD700" Foreground="Black" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnAdminPanel" Content="⚙" Visibility="Collapsed" Click="BtnAdminPanel_Click" Width="35" Height="35" Margin="10,0,0,0" Background="#333" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= CORPUL PRINCIPAL ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <Border x:Name="PromoBanner" Height="280" CornerRadius="15" Margin="0,10,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1a1a1a" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFD700"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="50,0,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="BONUS DE BUN VENIT:" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="100% PÂNĂ LA 1000 RON" Foreground="#FFD700" FontSize="36" FontWeight="Black" Effect="{StaticResource NeonGlow}"/>
                            <TextBlock Text="+ 150 ROTIRI GRATUITE!" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

                            <Button Content="JOACĂ ACUM" Width="160" Height="45" Background="#FFD700" Foreground="Black" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="22"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- JOCURI ȘI SIDEBAR -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <WrapPanel x:Name="PanelCasino" Margin="0,0,0,20">
                            <Button Content="Sizzling Hot" Tag="🎰" Click="BtnSlots_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Ruletă Europeană" Tag="🎡" Click="BtnRoulette_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Blackjack Pro" Tag="🃏" Click="BtnBlackjack_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Pariuri Sportive" Tag="⚽" Click="BtnSports_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Alba-Neagra" Tag="🎩" Click="BtnAlbaNeagra_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Mines" Tag="💣" Click="BtnMines_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Aviator" Tag="✈️" Click="BtnAviator_Click" Style="{StaticResource AuroraGameCard}"/>
                        </WrapPanel>

                        <WrapPanel x:Name="PanelEdu" Margin="0,0,0,20">
                            <Button Content="Triviador RO" Tag="🧠" Click="BtnTriviador_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Wordle RO" Tag="🔤" Click="BtnWordle_Click" Style="{StaticResource AuroraGameCard}"/>
                            <Button Content="Cifre și Calcule" Tag="🔢" Click="BtnCifre_Click" Style="{StaticResource AuroraGameCard}"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <Border Background="#111" CornerRadius="12" BorderBrush="#FFD700" BorderThickness="2" Padding="20" Effect="{StaticResource NeonGlow}" Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👑" FontSize="30" Foreground="#FFD700" HorizontalAlignment="Center"/>
                                <TextBlock Text="JACKPOT TOTAL" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <TextBlock Text="14.789.231 RON" Foreground="#FFD700" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                                <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                                <TextBlock Text="Câștigător recent:" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mihai_G. - 120.500 RON" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#111" CornerRadius="12" BorderBrush="#333" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ULTIMELE PROMOȚII" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Turneu de Weekend!" Foreground="#FFD700" FontWeight="Bold"/>
                                        <TextBlock Text="Joacă la păcănele și adună puncte." Foreground="#AAA" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,5"/>
                                        <TextBlock Text="Fond de premiere: 50.000 RON" Foreground="White" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1A1A1A" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Bonus VIP Cashback" Foreground="#FFD700" FontWeight="Bold"/>
                                        <TextBlock Text="Recuperează până la 15% din pierderi." Foreground="#AAA" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,5"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>