<Window x:Class="LoseBet.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoseBet - Casino Dashboard" Height="500" Width="700" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <TextBlock x:Name="TxtWelcome" Text="Salut, Jucătorule!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left"/>

            <StackPanel HorizontalAlignment="Right">
                <TextBlock x:Name="TxtBalance" Text="Sold: 0.00 RON" FontSize="20" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Right"/>
                <Button Content="👛 Casierie (Depuneri/Retrageri)" Click="BtnWallet_Click" Width="190" Height="25" Margin="0,5,0,0" Background="LightYellow" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ALEGE UN JOC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <WrapPanel HorizontalAlignment="Center">
                <Button Content="🎰 Păcănele (Slots)" Click="BtnSlots_Click" Width="150" Height="100" Margin="10" Background="LightGray" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="🎡 Ruletă" Click="BtnRoulette_Click" Width="150" Height="100" Margin="10" Background="LightGray" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="🃏 Blackjack" Click="BtnBlackjack_Click" Width="150" Height="100" Margin="10" Background="LightGray" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="⚽ Pariuri Sportive" Click="BtnSports_Click" Width="150" Height="100" Margin="10" Background="LightGray" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
            </WrapPanel>
        </StackPanel>

        <Button Grid.Row="2" Content="Delogare (Logout)" Click="BtnLogout_Click" Width="120" Height="35" HorizontalAlignment="Right" Background="DarkRed" Foreground="White" Margin="0,20,0,0" Cursor="Hand"/>
    </Grid>
</Window>